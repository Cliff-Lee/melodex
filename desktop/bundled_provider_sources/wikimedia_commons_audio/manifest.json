{
  "schema_version": 1,
  "id": "org.melodex.wikimedia.commons.audio",
  "name": "Wikimedia Commons Audio",
  "version": "0.1.2",
  "publisher": "Melodex",
  "protocol_version": "1.0",
  "description": "Search openly licensed and public-domain audio on Wikimedia Commons. Examples: Bach, piano, bird song, Apollo 11, speeches, field recordings, pronunciation.",
  "homepage": "https://commons.wikimedia.org/",
  "capabilities": [
    "search",
    "track",
    "playback"
  ],
  "permissions": {
    "network_hosts": [
      "commons.wikimedia.org",
      "upload.wikimedia.org"
    ],
    "offline_downloads": false,
    "local_files": false,
    "browser_auth": false,
    "lan_discovery": false
  },
  "entrypoints": {
    "python": "provider.py"
  }
}
