{
  "schema_version": "0.1",
  "extension_id": "org.melodex.example.musicbrainz-connections",
  "name": "MusicBrainz Song Connections",
  "version": "0.1.1",
  "publisher": "Melodex examples",
  "description": "Shows samples, remixes, versions, linked works and recording places from the MusicBrainz relationship graph.",
  "permissions": {
    "network_hosts": [
      "musicbrainz.org"
    ],
    "local_files": false,
    "browser_auth": false
  },
  "entrypoints": {
    "python": "plugin.py"
  },
  "contracts": [
    {
      "capability": "context",
      "contract_version": "0.1",
      "method": "context.lookup"
    }
  ]
}
