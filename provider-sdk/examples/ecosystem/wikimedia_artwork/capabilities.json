{
  "schema_version": "0.1",
  "extension_id": "org.melodex.example.wikimedia-commons",
  "name": "Wikimedia Commons Artwork Example",
  "version": "0.1.1",
  "publisher": "Melodex examples",
  "description": "Artwork enrichment using Wikimedia Commons with per-file provenance and licensing.",
  "permissions": {
    "network_hosts": [
      "commons.wikimedia.org",
      "upload.wikimedia.org"
    ],
    "local_files": false,
    "browser_auth": false
  },
  "entrypoints": {
    "python": "plugin.py"
  },
  "contracts": [
    {
      "capability": "artwork",
      "contract_version": "0.1",
      "method": "artwork.lookup"
    }
  ]
}
