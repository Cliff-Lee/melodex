{
  "schema_version": 1,
  "id": "org.melodex.example.openverse-audio",
  "name": "Openverse Audio Example",
  "version": "0.1.2",
  "publisher": "Melodex examples",
  "protocol_version": "1.0",
  "description": "Search and play openly licensed audio indexed by Openverse while preserving source, licence and attribution metadata.",
  "capabilities": [
    "search",
    "track",
    "playback"
  ],
  "permissions": {
    "network_hosts": [
      "api.openverse.org",
      "*"
    ],
    "offline_downloads": false,
    "local_files": false,
    "browser_auth": false,
    "lan_discovery": false
  },
  "entrypoints": {
    "python": "provider.py"
  }
}
