{
  "schema_version": 1,
  "id": "org.melodex.example.radio-browser",
  "name": "Radio Browser Example",
  "version": "0.1.1",
  "publisher": "Melodex examples",
  "protocol_version": "1.0",
  "description": "Example provider for the free/open Radio Browser community radio index. Search station names such as jazz, BBC or ambient.",
  "capabilities": [
    "search",
    "track",
    "playback"
  ],
  "permissions": {
    "network_hosts": [
      "all.api.radio-browser.info",
      "*.api.radio-browser.info"
    ],
    "offline_downloads": false,
    "local_files": false,
    "browser_auth": false,
    "lan_discovery": false
  },
  "entrypoints": {
    "python": "provider.py"
  }
}
