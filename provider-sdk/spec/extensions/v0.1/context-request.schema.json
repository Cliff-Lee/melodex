{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodex.example/schema/extensions/v0.1/context-request.schema.json",
  "title": "Melodex context lookup request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "capability": {
      "const": "context"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/EntityRef"
    },
    "requested_cards": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_cards": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  }
}
