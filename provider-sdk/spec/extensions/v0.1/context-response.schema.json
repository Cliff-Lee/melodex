{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodex.example/schema/extensions/v0.1/context-response.schema.json",
  "title": "Melodex context lookup response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "subject",
    "cards"
  ],
  "$defs": {
    "ContextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "canonical_ids": {
          "$ref": "common.schema.json#/$defs/CanonicalIds"
        }
      }
    },
    "ContextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "ContextCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "list",
            "facts"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "text": {
          "type": "string",
          "maxLength": 12000
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/ContextItem"
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/ContextFact"
          }
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "facts"
              }
            }
          },
          "then": {
            "required": [
              "facts"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "capability": {
      "const": "context"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/EntityRef"
    },
    "cards": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/ContextCard"
      }
    },
    "cache": {
      "$ref": "common.schema.json#/$defs/CacheDirective"
    }
  }
}
