{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodex.example/schema/extensions/v0.1/identity-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability", "subject"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "capability": {"const": "identity"},
    "subject": {"$ref": "common.schema.json#/$defs/EntityRef"},
    "wanted_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 20}
  }
}
