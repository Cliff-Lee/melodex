{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodex.example/schema/extensions/v0.1/artwork-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "capability": {
      "const": "artwork"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/EntityRef"
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cover",
          "portrait",
          "background",
          "thumbnail",
          "logo",
          "other"
        ]
      }
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
