{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodex.example/schema/extensions/v0.1/capabilities.schema.json",
  "title": "Melodex capability extension descriptor v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "extension_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "local_files": {
          "type": "boolean"
        },
        "browser_auth": {
          "type": "boolean"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "python": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "macos-arm64": {
          "type": "string"
        },
        "macos-x86_64": {
          "type": "string"
        },
        "windows-x86_64": {
          "type": "string"
        },
        "windows-arm64": {
          "type": "string"
        },
        "linux-x86_64": {
          "type": "string"
        },
        "linux-arm64": {
          "type": "string"
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "contract_version",
          "method"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "identity",
              "metadata",
              "artwork",
              "lyrics",
              "context",
              "library_suggestions"
            ]
          },
          "contract_version": {
            "const": "0.1"
          },
          "method": {
            "type": "string",
            "enum": [
              "identity.resolve",
              "metadata.enrich",
              "artwork.lookup",
              "lyrics.lookup",
              "context.lookup",
              "library.suggest"
            ]
          }
        }
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "secret",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "help": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "method"
      ],
      "properties": {
        "contract_version": {
          "const": "0.1"
        },
        "method": {
          "const": "extension.health"
        }
      }
    }
  }
}
